       IDENTIFICATION DIVISION.
       PROGRAM-ID. COINBASE.
       DATA DIVISION.
       FILE SECTION.
       WORKING-STORAGE SECTION.
       01 VERDE        PIC 9(6) VALUE 100000.
       01 MORADO       PIC 9(5) VALUE 50000.
       01 AZUL         PIC 9(5) VALUE 20000.
       01 POLA         PIC 9(5) VALUE 10000.
       01 CAFE         PIC 9(4) VALUE 5000.
       01 SANTANDER    PIC 9(4) VALUE 2000.
       01 OPCION       PIC 9.
       01 PRIMERA      PIC 9(6).
       01 SEGUNDA      PIC 9(5).
       01 TERCERA      PIC 9(5).
       01 CUARTA       PIC 9(5).
       01 QUINTA       PIC 9(5).
       01 SEXTA        PIC 9(4).
       01 RESULTADO    PIC 9(6).
       PROCEDURE DIVISION.
       MAIN-PROCEDURE.
           DISPLAY "ENTER A NUMBER."
           ACCEPT OPCION.

           COMPUTE
               PRIMERA = VERDE * OPCION.
           COMPUTE
               SEGUNDA = MORADO * OPCION.
           COMPUTE
               TERCERA = AZUL * OPCION.
           COMPUTE
               CUARTA = POLA * OPCION.
           COMPUTE
               QUINTA = CAFE * OPCION.
           COMPUTE
               SEXTA = SANTANDER * OPCION.
           COMPUTE
               RESULTADO = PRIMERA + SEGUNDA + TERCERA + CUARTA +
               QUINTA + SEXTA.

           DISPLAY RESULTADO

           STOP RUN.
       END PROGRAM COINBASE.
